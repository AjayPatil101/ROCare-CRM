# ==================== SERVER ====================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ==================== DATABASE ====================
MONGO_URI=mongodb://127.0.0.1:27017/ro_service_db
# For MongoDB Atlas:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/ro_service_db?retryWrites=true&w=majority

# ==================== AUTH / JWT ====================
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d
JWT_RESET_SECRET=replace_this_with_another_long_random_secret_string
JWT_RESET_EXPIRES_IN=15m

# ==================== EMAIL (Nodemailer) ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="RO Service Management <no-reply@roservice.com>"

# ==================== FILE UPLOADS ====================
MAX_FILE_UPLOAD_MB=5
UPLOAD_PATH=./uploads

# ==================== RATE LIMITING ====================
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=200
